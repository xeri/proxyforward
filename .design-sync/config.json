{
  "projectId": "15c99c85-29eb-46c5-bc9c-2f100e3950e8",
  "shape": "package",
  "pkg": "frontend",
  "globalName": "Proxyforward",
  "entry": "frontend/dist/.no-lib-entry.js",
  "srcDir": "src/components",
  "tsconfig": "tsconfig.json",
  "buildCmd": "cd frontend && npm run build && node ../.design-sync/prepare-css.mjs",
  "cssEntry": ".ds-css/app.css",
  "guidelinesGlob": ["DESIGN.md"],
  "readmeHeader": ".design-sync/conventions.md",
  "extraFonts": ["node_modules/@fontsource-variable/inter/index.css"],
  "extraEntries": ["../.design-sync/ds-root.tsx"],
  "provider": {"component": "DSRoot"},
  "overrides": {
    "Modal": {"cardMode": "single", "viewport": "760x560"},
    "Menu": {"cardMode": "single", "viewport": "480x420"},
    "LineChart": {"cardMode": "column", "primaryStory": "TrafficBinary"},
    "WorldMap": {"cardMode": "column", "primaryStory": "Activity"},
    "BandwidthPanel": {"cardMode": "column", "primaryStory": "FullCard"},
    "Banner": {"cardMode": "column", "primaryStory": "Tones"},
    "ErrorBanner": {"cardMode": "column", "primaryStory": "IssueFailure"},
    "Overline": {"cardMode": "column"}
  },
  "componentSrcMap": {
    "PageHeader": "src/components/ui.tsx",
    "Overline": "src/components/ui.tsx",
    "Card": "src/components/ui.tsx",
    "SignalCard": "src/components/ui.tsx",
    "StatTile": "src/components/ui.tsx",
    "Pill": "src/components/ui.tsx",
    "PillGroup": "src/components/ui.tsx",
    "RoleWord": "src/components/ui.tsx",
    "LiveDot": "src/components/ui.tsx",
    "SectionHeader": "src/components/ui.tsx",
    "Button": "src/components/ui.tsx",
    "IconButton": "src/components/ui.tsx",
    "Field": "src/components/ui.tsx",
    "TextInput": "src/components/ui.tsx",
    "Checkbox": "src/components/ui.tsx",
    "Select": "src/components/ui.tsx",
    "Menu": "src/components/ui.tsx",
    "MenuItem": "src/components/ui.tsx",
    "Switch": "src/components/ui.tsx",
    "Toggle": "src/components/ui.tsx",
    "StatusDot": "src/components/ui.tsx",
    "Badge": "src/components/ui.tsx",
    "MonoChip": "src/components/ui.tsx",
    "FormRow": "src/components/ui.tsx",
    "WarnWash": "src/components/ui.tsx",
    "Kbd": "src/components/ui.tsx",
    "Skeleton": "src/components/ui.tsx",
    "SegmentedControl": "src/components/ui.tsx",
    "Disclosure": "src/components/ui.tsx",
    "Banner": "src/components/ui.tsx",
    "ErrorBanner": "src/components/ui.tsx",
    "CopyButton": "src/components/ui.tsx",
    "CopyIcon": "src/components/ui.tsx",
    "Spinner": "src/components/ui.tsx",
    "EmptyState": "src/components/ui.tsx",
    "Modal": "src/components/ui.tsx",
    "Codebox": "src/components/ui.tsx",
    "NumberTicker": "src/components/NumberTicker.tsx",
    "DataTable": "src/components/DataTable.tsx",
    "Emblem": "src/components/Emblem.tsx",
    "AvatarImg": "src/components/AvatarImg.tsx",
    "GeoRank": "src/components/GeoRank.tsx",
    "ConnectionPill": "src/components/ConnectionPill.tsx",
